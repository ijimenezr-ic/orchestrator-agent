# GitHub token — in Copilot environments this is set automatically.
# For local development, create a fine-grained PAT with "Models: read" permission
# at https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=your-github-token-here

# GitHub Models API endpoint (default is the public endpoint)
GITHUB_MODELS_URL=https://models.inference.ai.azure.com

# Model IDs from the GitHub Models catalog (https://github.com/marketplace/models)
ORCHESTRATOR_MODEL=claude-opus-4-5
SUBAGENT_MODEL=claude-sonnet-4-5
